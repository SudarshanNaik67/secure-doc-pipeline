{
  "name": "box-service",
  "version": "1.0.0",
  "description": "Box Cloud Integration Service: receives sanitized files and uploads them to Box",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
