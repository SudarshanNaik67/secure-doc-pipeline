# Copy to ".env" (cp .env.example .env) to customise docker compose.
# Everything here is OPTIONAL: the stack runs with built-in defaults.

# --- Shared secret between scanner-service and box-service (CHANGE IT) ---
INTERNAL_API_KEY=dev-internal-key-change-me

# --- Optional: require this key (header X-API-Key) on the public scan API ---
INGEST_API_KEY=

# --- DLP policy: false = mask & forward, true = reject files containing PII ---
DLP_BLOCK_ON_FINDINGS=false

# --- Box: mock mode needs no account. Set to false to use real Box. ---
BOX_MOCK_MODE=true
# Real Box, option 1 (easiest, token lasts 60 min): developer token
BOX_DEVELOPER_TOKEN=
# Real Box, option 2: Client Credentials Grant (server auth app)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
# "0" = root folder of the Box account
BOX_PARENT_FOLDER_ID=0

# --- MongoDB: default is the bundled container. For Atlas, paste your URI: ---
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dlp_pipeline
